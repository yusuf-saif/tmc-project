# ── Application ───────────────────────────────────────
APP_NAME="The Muhsinat Club"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# ── Database (Railway: use pgsql + Postgres plugin) ──
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=themuhsinatclub
DB_USERNAME=saifkqfo
DB_PASSWORD=

# ── Session / Cache / Queue (use database on Railway) ─
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

CACHE_STORE=database

QUEUE_CONNECTION=database

# ── Filament ─────────────────────────────────────────

# ── Mail (Resend) ─────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@themuhsinatclub.com"
MAIL_FROM_NAME="The Muhsinat Club"
RESEND_API_KEY=

# ── Storage (uses R2/S3 for uploaded files) ─
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Logging ──────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=notice

BROADCAST_CONNECTION=log

# ── Web Push (VAPID) ─────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@themuhsinatclub.com"

# ── Paystack ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── Sentry (optional) ────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
