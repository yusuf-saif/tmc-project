# ── APPLICATION ───────────────────────────────────────────
APP_NAME="The Muhsinat Club"
APP_ENV=local
APP_KEY=base64:L25qK15MQrg0Ou6iPxdpUnP/bT5ui/va8OvCSfCOjhk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# ── DATABASE ───────────────────────────────────────────────
DB_CONNECTION=sqlite
DB_DATABASE=/Users/saifyusuph/Downloads/tmc-project/database/database.sqlite

# ── MAIL (log = no emails sent, writes to storage/logs) ───
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@themuhsinatclub.com"
MAIL_FROM_NAME="The Muhsinat Club"

# ── CACHE / SESSION / QUEUE ────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── LOGGING ────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── FILESYSTEM ─────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── BROADCAST ─────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── VITE ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── PUSH NOTIFICATIONS (Phase 8 — leave blank for now) ────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@themuhsinatclub.com"