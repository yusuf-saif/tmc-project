{
  "build": {
    "base": "php:8.4",
    "commands": [
      "composer install --no-dev --optimize-autoloader",
      "npm ci",
      "npm run build"
    ]
  },
  "start": "php artisan migrate --force && php artisan optimize && php artisan serve --host=0.0.0.0 --port=$PORT",
  "variables": [
    "APP_KEY",
    "APP_ENV",
    "APP_DEBUG",
    "LOG_CHANNEL",
    "DB_CONNECTION",
    "DATABASE_URL"
  ]
}