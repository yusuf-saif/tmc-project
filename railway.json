{
  "deploy": {
    "startCommand": "php artisan octane:start --server=swoole --host=0.0.0.0 --port=$PORT"
  },
  "plugins": [
    {
      "type": "postgresql",
      "name": "PostgreSQL",
      "settings": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  ],
  "env": {
    "APP_KEY": "",
    "DB_CONNECTION": "pgsql",
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}